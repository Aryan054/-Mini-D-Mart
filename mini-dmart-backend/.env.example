# Django Secret Key (Generate a new one for production!)
DJANGO_SECRET_KEY=django-insecure-replace-me-with-a-real-secret-key

# Debug Mode (Set to False in production)
DJANGO_DEBUG=True

# Allowed Hosts (Comma separated, e.g., 'localhost,127.0.0.1,.yourdomain.com')
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings (Update these when switching to PostgreSQL)
# Example for PostgreSQL:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mini_dmart
DB_USER=postgres
DB_PASSWORD=your-postgresql-password
DB_HOST=localhost
DB_PORT=5432
