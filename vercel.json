{
  "version": 2,
  "builds": [
    {
      "src": "mini-dmart-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "mini-dmart-backend/vercel_wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/mini-dmart-backend/vercel_wsgi.py"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/mini-dmart-frontend/assets/$1"
    },
    {
      "source": "/(.*\\.(svg|ico|png|jpg|jpeg))$",
      "destination": "/mini-dmart-frontend/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/mini-dmart-frontend/index.html"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings.base"
  }
}
