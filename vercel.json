{
  "version": 2,
  "builds": [
    {
      "src": "mini-dmart-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "mini-dmart-backend/vercel_wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/mini-dmart-backend/vercel_wsgi.py"
    },
    {
      "src": "/(.*\\.(js|css|svg|png|jpg|jpeg|ico|json|woff2?|ttf|eot))$",
      "dest": "/mini-dmart-frontend/dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/mini-dmart-frontend/dist/index.html"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings.base"
  }
}
