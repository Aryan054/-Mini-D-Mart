{
  "version": 2,
  "builds": [
    {
      "src": "mini-dmart-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "mini-dmart-backend/vercel_wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/mini-dmart-backend/vercel_wsgi.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/mini-dmart-backend/vercel_wsgi.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/mini-dmart-backend/vercel_wsgi.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/mini-dmart-frontend/assets/$1"
    },
    {
      "src": "/(.*\\.(svg|ico|png|jpg|jpeg|js|css|json|woff2?|ttf|eot))$",
      "dest": "/mini-dmart-frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/mini-dmart-frontend/index.html"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings.base"
  }
}
